{
  "name": "family-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-console-e2e.mjs",
    "build": "npm run typecheck && vite build",
    "ui:catalog": "vite --host 127.0.0.1 --port 18082 --strictPort",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "check:ui-boundaries": "node scripts/check-ui-boundaries.mjs",
    "pretest:e2e": "node scripts/build-consolefixture.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
